local utils             = require "example.scripts.utils"
local const             = require "example.scripts.const"
local data              = require "example.scripts.data"
local draw              = require "example.scripts.draw"

--==========================================================
-- VARIABLES
--==========================================================
local nodes             = {}
local edges             = {}
local grid              = {}
local get_spatial_index = true
local node_instances    = {}
local projected_count   = 2
local mouse_position    = vmath.vector3()
local target_position   = vmath.vector3()
local path              = {
	node_to_node = {
		size        = 0,
		status      = -1,
		status_text = "",
		path        = {}
	},
	projected_to_node = {
		path_size   = 0,
		status      = -1,
		status_text = "",
		entry_point = vmath.vector3(),
		path        = {}
	},
	projected_to_projected = {
		path_size   = 0,
		status      = -1,
		status_text = "",
		entry_point = vmath.vector3(),
		exit_point  = vmath.vector3(),
		path        = {}
	}
}

--==========================================================
-- FUNCTIONS
--==========================================================
function init(self)
	msg.post(".", "acquire_input_focus")

	-- Load graph data from JSON files
	local loaded_data = utils.load_data()
	if not loaded_data then
		print("Failed to load graph data")
		return
	end

	print("Loaded", #loaded_data.nodes, "nodes")

	-- Calculate total nodes needed (graph nodes + extra for projected pathfinding)
	local max_nodes = #loaded_data.nodes + projected_count
	local max_gameobject_nodes = 2
	local max_edges_per_node = 8
	local heap_pool_block_size = 32
	local max_cache_path_length = 32

	-- Initialize the pathfinder system
	pathfinder.init(max_nodes, max_gameobject_nodes, max_edges_per_node, heap_pool_block_size, max_cache_path_length)

	pathfinder.set_spatial_index(70, 20, 30, 1)

	-- Create path smoothing configuration
	data.path_smoothing_id = pathfinder.add_path_smoothing(const.SMOOTHING_CONFIG)

	-- Create nodes and edges from loaded data
	nodes                  = pathfinder.add_nodes(loaded_data.nodes)
	edges                  = loaded_data.edges
	pathfinder.add_edges(loaded_data.edges)

	-- Add one more edge
	pathfinder.add_edge(48, 47, false)
	table.insert(edges, {
		from_node_id = 48,
		to_node_id = 47,
		bidirectional = false
	})

	-- Create visual representations
	node_instances = utils.add_nodes(nodes)
	utils.add_edge_directions(edges)

	-- Convert node 56 to a game object node and animate it
	-- This demonstrates automatic position tracking
	pathfinder.convert_gameobject_node(56, node_instances[56])

	local instance_position = pathfinder.get_node_position(56)
	go.animate(node_instances[56], "position.y", go.PLAYBACK_LOOP_PINGPONG, instance_position.y + 150, go.EASING_INOUTSINE, 1)

	-- target
	target_position = go.get_position("/target")
	go.animate("/target", "position.y", go.PLAYBACK_LOOP_PINGPONG, target_position.y + 190, go.EASING_INOUTSINE, 3)
	go.animate("/target", "position.x", go.PLAYBACK_LOOP_PINGPONG, target_position.x + 50, go.EASING_INOUTSINE, 3)
end

function update(self, dt)
	-- Draw all edges
	draw.edges(edges)

	if pathfinder.spatial_index_initialized() then
		if get_spatial_index then
			grid = pathfinder.get_spatial_index()
			get_spatial_index = false
		end
		draw.grid(grid)
	end

	--==========================================================
	-- Example 1: Static pathfinding between two fixed nodes
	-- Find and draw a smoothed path from node 0 to node 66
	--==========================================================
	path.node_to_node.size,
	path.node_to_node.status,
	path.node_to_node.status_text,
	path.node_to_node.path = pathfinder.find_node_to_node(63, 57, 32, data.path_smoothing_id)

	if path.node_to_node.status == pathfinder.PathStatus.SUCCESS then
		draw.node_to_node(path.node_to_node.size, path.node_to_node.path, true)
	end

	--==========================================================
	-- Example 2: Dynamic projected pathfinding following mouse cursor
	-- Find and draw a path from mouse position to node 95
	--==========================================================
	path.projected_to_node.size,
	path.projected_to_node.status,
	path.projected_to_node.status_text,
	path.projected_to_node.entry_point,
	path.projected_to_node.path = pathfinder.find_projected_to_node(mouse_position.x, mouse_position.y, 57, 32, data.path_smoothing_id)

	if path.projected_to_node.status == pathfinder.PathStatus.SUCCESS then
		draw.projected(mouse_position, target_position, path.projected_to_node.size, path.projected_to_node.entry_point, nil, path.projected_to_node.path)
	end

	--==========================================================
	-- Example 3: Dynamic projected pathfinding from mouse cursor to target position
	--==========================================================
	target_position = go.get_position("/target")

	path.projected_to_projected.size,
	path.projected_to_projected.status,
	path.projected_to_projected.status_text,
	path.projected_to_projected.entry_point,
	path.projected_to_projected.exit_point,
	path.projected_to_projected.path = pathfinder.find_projected_to_projected(
		mouse_position.x,
		mouse_position.y,
		target_position.x,
		target_position.y,
		32,
		data.path_smoothing_id)


	if path.projected_to_projected.status == pathfinder.PathStatus.SUCCESS then
		draw.projected(mouse_position, target_position, path.projected_to_projected.size, path.projected_to_projected.entry_point, path.projected_to_projected.exit_point, path.projected_to_projected.path)
	end
end

function on_input(self, action_id, action)
	-- Track mouse position for projected pathfinding
	if action.x then
		mouse_position.x = action.x
		mouse_position.y = action.y
		go.set_position(mouse_position, "/mouse")
	end
end
